# Development defaults. Generate a new secret for each deployment.
APP_ENV=development
FLASK_SECRET=
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# Production-only: set APP_ENV=production, use a secret of at least 32 bytes,
# and list the externally served DNS names here (comma-separated).
# TRUSTED_HOSTS=phishguard.example.com

# Optional: creates/promotes this account to admin on startup when both are set.
# Use a unique password of at least 12 characters. Never commit real credentials.
# PHISHGUARD_ADMIN_EMAIL=
# PHISHGUARD_ADMIN_PASSWORD=
